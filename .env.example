# Gateway
PORT=7373
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*
# Security: bootstrap endpoint disabled by default. Set to 1 only for local dev/private self-hosted to auto-expose MASTER_KEY
EXPOSE_BOOTSTRAP=0
# Dev helpers: set to 1 to re-enable legacy mock fallbacks / fgk- bypass (never in production)
ALLOW_MOCK=0
ALLOW_DEV_FALLBACK=0
# Verify TLS certificate (corporate proxy SSL inspection)
NODE_TLS_REJECT_UNAUTHORIZED=0

# TLS — dev-only behind corporate proxy with SSL inspection (Zscaler, etc.)
# WARNING: disables TLS verification globally → MITM risk. NEVER in production.
# Uncomment only if you get UNABLE_TO_VERIFY_LEAF_SIGNATURE / SELF_SIGNED_CERT_IN_CHAIN behind proxy:
# NODE_TLS_REJECT_UNAUTHORIZED=0
# Safer alternative (keep verification, trust corporate CA):
# NODE_EXTRA_CA_CERTS=/path/to/corporate-ca.crt

# Database & Cache
DATABASE_URL=file:./data.db
# DATABASE_URL=postgres://user:password@localhost:5432/gateway
REDIS_URL=redis://localhost:6379
# REDIS_URL=  # để trống sẽ fallback in-memory

# Security (OPTIONAL — auto-generated on first boot if missing/placeholder)
# MASTER_KEY is your single API key for both /v1/* and /api/* (admin). If left as placeholder, gateway generates
#   fgk-master-<hex> and persists to .env (or data/.gateway-keys.json when no .env, e.g. Docker) — check logs on first start.
# ENCRYPTION_KEY is internal AES-256-GCM key for at-rest encryption (never used as API key). Auto-generated 64 hex if missing.
# Override only for production / secret manager.
MASTER_KEY=fgk-master-change-me-please-generate-a-secure-random-key
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Router
DEFAULT_MODEL=auto
FALLBACK_TIERS=[["pollinations","llm7-io","kilo-code","nvidia-nim","agnes-ai","hugging-face","orcarouter","openrouter","ollama-cloud","groq","cerebras","google-gemini","github-models","modelscope","chutes-ai","sambanova","siliconflow","cohere","mistral-ai","cloudflare-workers-ai","ovhcloud-ai-endpoints","aion-labs","z-ai-zhipu-ai","experientiallabs","opencode","freeai","cline","together","fireworks","novita","deepseek","grok-xai","alibaba-cloud-model-studio","nscale","nebius","ai21-labs","anthropic","claude-code","codex"]]
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# ── Provider Keys (comma-separated for round-robin pool) ──
# Nguồn: freellms.org — 30 providers, 316 free models (2026-09-06)
# Permanent Free / No Card: 29/30

# Core — OpenAI compatible
GROQ_API_KEYS=gsk_xxx
CEREBRAS_API_KEYS=csk_xxx
NVIDIA_API_KEYS=nvapi-xxx
GITHUB_TOKENS=ghp_xxx
OPENROUTER_API_KEYS=sk-or-xxx

# Gemini (special translator)
GEMINI_API_KEYS=AIza_xxx

# Cloudflare (cần ACCOUNT_ID + TOKEN)
CLOUDFLARE_API_TOKEN=cf_xxx
CLOUDFLARE_ACCOUNT_ID=acc_xxx

# Cohere / Mistral / Together / Fireworks / SambaNova / SiliconFlow / Chutes / HuggingFace
COHERE_API_KEYS=co_xxx
MISTRAL_API_KEYS=mst_xxx
TOGETHER_API_KEYS=tvy_xxx
FIREWORKS_API_KEYS=fw_xxx
SAMBANOVA_API_KEYS=sn_xxx
SILICONFLOW_API_KEYS=sk-xxx
CHUTES_API_KEYS=ch_xxx
HUGGINGFACE_API_KEYS=hf_xxx
NOVITA_API_KEYS=nv_xxx

# Freellms — new providers (2026-09-06 scan)
# ModelScope: https://api-inference.modelscope.cn/v1 — 43 free models
MODELSCOPE_API_KEYS=ms_xxx
# OVHcloud: https://oai.endpoints.kepler.ai.cloud.ovh.net/v1 — 10 free
OVHCLOUD_API_KEYS=ovh_xxx
# Kilo Code: https://api.kilo.ai/api/gateway — 8 free, :free suffix, ~200 req/hr
KILO_CODE_API_KEYS=kc_xxx
# OpenCode Zen: https://opencode.ai/zen/v1 — 8 free
OPENCODE_API_KEYS=oc_xxx
# LLM7.io: https://api.llm7.io/v1 — 6 free
LLM7_API_KEYS=llm7_xxx
# Agnes AI: https://apihub.agnes-ai.com/v1 — 5 free, 30 RPM
AGNES_API_KEYS=ag_xxx
# Aion Labs: https://api.aionlabs.ai/v1 — 5 free
AION_API_KEYS=aion_xxx
# Z AI (Zhipu): https://open.bigmodel.cn/api/paas/v4 — 4 free (GLM-4.7)
Z_AI_API_KEYS=zai_xxx
# Experiential Labs: https://api.experientiallabs.ai/v1 — 3 free promotional (qwen3.8-27b, deepseek-v4-flash, gpt-5.6-luna)
EXPERIENTIAL_API_KEYS=exp_xxx
EXPERIENTIAL_API_BASE=https://api.experientiallabs.ai/v1
# Ollama Cloud: https://api.ollama.com — 3 free, session limits
OLLAMA_CLOUD_API_KEYS=ollama_xxx
# Glhf.chat: https://glhf.chat/api/openai/v1 — 2 free
GLHF_API_KEYS=glhf_xxx
# Grok xAI: https://api.x.ai/v1 — 2 free, yêu cầu card
GROK_API_KEYS=xai_xxx
# DeepSeek: https://api.deepseek.com/v1 — free trial
DEEPSEEK_API_KEYS=sk-xxx
# xAI: https://api.x.ai/v1 — same as Grok
XAI_API_KEYS=xai_xxx
# Alibaba ModelStudio: https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEYS=sk-xxx
# Nscale / Nebius / AI21
NSCALE_API_KEYS=nsc_xxx
NEBIUS_API_KEYS=nebius_xxx
AI21_API_KEYS=ai21_xxx

# Custom from opencode.json (ORCAROUTER/FREEAI/CLINE)
ORCAROUTER_API_KEYS=sk-orca-xxx
FREEAI_API_KEYS=sk-free-xxx
CLINE_API_KEYS=sk-cline-xxx

# OVH / Agnes alternative naming (compat)
OVH_AI_API_KEYS=ovh_xxx

# Scraped / Unlimited (không cần key, dễ vỡ)
POLLINATIONS_API_KEY=
PUTER_API_KEY=

# Sync / Verify (24h)
SYNC_INTERVAL_MS=86400000
DISABLE_SCHEDULER=0

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Dashboard
VITE_GATEWAY_URL=http://localhost:7373

# ── Claude Code / Codex (custom) ──
# CLAUDE_CODE: uses Anthropic API (same as ANTHROPIC_API_KEYS, OAuth via Claude Code CLI or API key)
CLAUDE_CODE_API_KEYS=
# CODEX: OpenAI Codex (requires OPENAI_API_KEYS or CODEX_API_KEYS)
CODEX_API_KEYS=
OPENAI_API_KEYS=sk-proj-xxx

# ── Vector 1+2 — Audio / Responses / Anthropic / Semantic Cache / Compression / Cost Routing / Analytics (2026-09-08) ──
# Anthropic-compatible /v1/messages upstream (comma-separated for round-robin pool, same as other providers)
ANTHROPIC_API_KEYS=

# Semantic cache — vector similarity cache for /v1/chat/completions + /v1/messages
# Enabled only if SEMANTIC_CACHE_ENABLED=1 and EMBEDDING_MODEL reachable (Cohere by default, fallback in-memory + Redis + hash exact)
SEMANTIC_CACHE_ENABLED=0
# Cosine similarity threshold for cache hit (0.0-1.0, higher = stricter). 0.92 recommended for cohere/embed-english-v3.0
SEMANTIC_THRESHOLD=0.92
# TTL for cached completions in seconds (3600 = 1 hour)
CACHE_TTL_S=3600
# Embedding model for semantic cache — can be comma-separated for fallback chain. Primary first, then fallbacks.
# Default chain: cohere/embed-english-v3.0 → nvidia/nv-embed-v1 → cloudflare bge-large. If all fail, falls back to sha256 exact hash.
EMBEDDING_MODEL=cohere/embed-english-v3.0
EMBEDDING_FALLBACKS=nvidia-nim/nvidia/nv-embed-v1,cloudflare-workers-ai/@cf/baai/bge-large-en-v1.5

# Token compression — reduces history + tools payload before upstream (12-engine pattern like OmniRoute)
COMPRESSION_ENABLED=0
# Max tokens budget before compression pipeline kicks in (harness 02 Build Context)
COMPRESSION_MAX_TOKENS=4096

# Cost-aware routing — when enabled, router prefers cheapest free provider first (ties broken by latency/verified)
COST_ROUTING_ENABLED=0
# Weights for cost-router scoring (harness 06 Decide Tools) — score = cost*COST_WEIGHT + latency*LATENCY_WEIGHT - headroom*HEADROOM_WEIGHT
COST_WEIGHT=5
LATENCY_WEIGHT=0.0005
HEADROOM_WEIGHT=0.3

# Semantic cache advanced (harness 01 Retrieve — Hybrid Search + RRF)
SEMANTIC_CACHE_MAX_MEM=1000
SEMANTIC_CACHE_SCAN_CAP=200

# Admin analytics retention — days to keep cost/savings/per-key billing rollups (costByProvider, cacheHitRate, p95)
ANALYTICS_RETENTION_DAYS=30
